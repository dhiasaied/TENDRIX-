# Default values for local development. Real environment variables win over .env files.
# DO NOT COMMIT PRODUCTION SECRETS: use real env vars or `symfony console secrets:set` in production.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev_only_change_me_0a1b2c3d4e5f
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost:8000

###> doctrine/doctrine-bundle ###
# Local development runs on SQLite with zero setup; Docker/production use PostgreSQL:
# DATABASE_URL="postgresql://tendrix:tendrix@database:5432/tendrix?serverVersion=16&charset=utf8"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Doctrine transport works everywhere; switch to redis://redis:6379/messages in Docker for throughput.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dev_only_jwt_passphrase
JWT_TTL=28800
# Session cookie "Secure" flag: 1 behind HTTPS (production). 0 only for plain-http local development.
JWT_COOKIE_SECURE=0
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> anthropic ###
# Optional: enables Claude-powered agents (tender drafting, matching analysis, pricing rationale).
# Without a key every agent falls back to its deterministic implementation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
###< anthropic ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> redis ###
REDIS_URL=redis://localhost:6379
###< redis ###
