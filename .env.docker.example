# Copy to .env.docker (`make up` does it and generates the secrets for you).
# The API refuses to start in production while a secret is a placeholder or shorter than 32 characters.
APP_ENV=prod
APP_SECRET=change_me
JWT_PASSPHRASE=change_me
JWT_TTL=28800
# Session cookie sent over HTTPS only. Browsers accept it on http://localhost for local testing.
JWT_COOKIE_SECURE=1
# Exact origin(s) of the SPA in production, e.g. '^https://vms\.example\.com$'
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Only nginx talks to PHP-FPM; it overwrites the X-Forwarded-* headers (docker/nginx/php-api.conf).
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
DEFAULT_URI=http://localhost:8080

# Optional integrations
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
SENTRY_DSN=

# 1 = load the DEMO dataset on first start (empty database only). Its accounts share a publicly
# documented password: local demos only, never on a reachable deployment.
LOAD_DEMO_DATA=0
